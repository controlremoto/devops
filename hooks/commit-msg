#!/bin/sh
# Enforce conventional commit format

COMMIT_MSG_FILE="$1"
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

echo "Commit message: '$COMMIT_MSG'"  # Debug line

# Extract the first line of the commit message
FIRST_LINE=$(echo "$COMMIT_MSG" | head -n 1)
echo "First line of commit message: '$FIRST_LINE'"  # Debug line

# Check if the first line follows the conventional commit format
if echo "$FIRST_LINE" | grep -qE '^(feat|fix|chore|docs|style|refactor|perf|test|revert):'; then
    exit 0
else
    echo "Commit message does not follow conventional commit format"
    exit 1
fi
